APP_NAME=Komero
APP_ENV=development
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg://komero:komero@localhost:5432/komero
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://komero.netlify.app
FRONTEND_URL=https://komero.netlify.app
RUN_SEED=false
CURRENCY_DEFAULT=XAF
TOKEN_ENCRYPTION_KEY=change-me-fernet-key-base64

# WhatsApp Meta Cloud API (leave empty to use mock adapter)
WHATSAPP_VERIFY_TOKEN=komero-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ADAPTER=mock

# AI provider (mock | openai | ... via factory)
AI_PROVIDER=mock
AI_API_KEY=

# Media storage
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
